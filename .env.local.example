# Loaded by Next.js on startup; restart the dev server after changes.
# Copy to .env.local for local development, then set your deployment values.
# Keycloak base URL, including /auth only if the installation uses that prefix.
KEYCLOAK_AUTH_URL=https://auth.example.com
# Tenant / realm containing the wallet client.
KEYCLOAK_REALM=your-tenant
# Fixed public OIDC client ID. No client secret belongs in this browser app.
KEYCLOAK_CLIENT_ID=wallet-web

# Public API addresses; same-origin paths work with a local reverse proxy.
WALLET_API_URL=/api
WALLET_ACCOUNT_SERVICE_URL=/api/accounts

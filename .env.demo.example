# Optional: copy these settings into .env.local.
# npm run demo already enables MOCK_MODE for local development.
MOCK_MODE=true
# Optional fixed signing key for local experiments. Without it a random key is used.
# MOCK_JWT_SECRET=replace-with-a-random-local-demo-secret

# QR image sources fetched by the mock (comma-separated exact origins).
MOCK_IMAGE_ORIGINS=http://localhost:4101
# Optional frontend address used by the third-party demo page.
MOCK_WALLET_URL=http://localhost:3000
